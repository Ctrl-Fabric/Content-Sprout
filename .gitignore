__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
.env.local
.DS_Store
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Local artifacts — keep dirs but ignore contents
input/*
output/*
projects/*
cache/*
scripts/*
!input/.gitkeep
!output/.gitkeep
!projects/.gitkeep
!cache/.gitkeep
!scripts/.gitkeep
# Packaging helper under scripts/ is tracked
!scripts/release-macos.sh

# Build
dist/
build/
*.egg-info/
node_modules/

# Angular UI (see ui/)
ui/node_modules/
ui/dist/
ui/.angular/
ui/out-tsc/
# Production UI bundle copied beside the Python package for packaged apps
src/content_sprout/ui_dist/*
!src/content_sprout/ui_dist/.gitkeep

# Landing page download binaries (large; produced by packaging/macos/build.sh)
landing/public/downloads/*
!landing/public/downloads/.gitkeep
# Legacy path (pre-Angular landing)
landing/downloads/*
!landing/downloads/.gitkeep
